{
  "configVersion": "v3",
  "app": {
    "appId": 200001,
    "appName": "课程表",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "developer",
    "description": "每日课程表，从手机端导入课程数据"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.5",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        { "st": "r", "dw": 480 }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "zh-CN": {
      "appName": "课程表"
    },
    "en-US": {
      "appName": "Schedule"
    }
  },
  "defaultLanguage": "zh-CN"
}
